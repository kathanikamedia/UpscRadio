{
  "name": "upsc-radio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname localhost --port 3000",
    "prebuild": "node scripts/check-deployment-env.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/platform.test.ts tests/upsc.test.ts tests/news.test.ts tests/performance.test.ts tests/security.test.ts tests/youtube.test.ts tests/resource-topics.test.ts tests/deployment.test.ts tests/storage.test.ts tests/free-course.test.ts tests/materials.test.ts tests/community.test.ts tests/exam.test.ts tests/mock-upload.test.ts",
    "check:database": "tsx scripts/check-database.ts",
    "copy:catalogue": "tsx scripts/copy-catalogue.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed:catalogue": "tsx scripts/seed-catalogue.ts",
    "check:storage": "tsx scripts/check-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
